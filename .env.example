# Get a key at https://console.anthropic.com/ (add a small amount of credit, e.g. $5)
ANTHROPIC_API_KEY=

# SEC EDGAR requires a contact in the User-Agent: "<app name> <your email>"
SEC_USER_AGENT="equity-research-agent your-email@example.com"

# Optional settings
# EQUITY_AGENT_MODEL=claude-sonnet-5-5   # or claude-opus-5-5 (best, ~2x cost) / claude-haiku-4-5 (cheapest)
# EQUITY_AGENT_EFFORT=medium             # low | medium | high
# EQUITY_AGENT_MAX_COST_USD=1.00         # hard spending cap per report
# EQUITY_AGENT_WEB_SEARCHES=5
